# Copy to .env in the repository root. Never commit secrets.
# Compose reads this file when invoked with --env-file .env.
COMPOSE_FILE=deploy/compose.yaml
COMPOSE_PROJECT_NAME=localrag
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Leave blank to select an installed completion model in the interface.
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
OLLAMA_TIMEOUT_SECONDS=180

# The active collection is tied to the embedding model name AND digest.
# Use a new collection and the rebuild command when changing the model.
QDRANT_COLLECTION=rag_documents
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5
RAG_TEMPERATURE=0.2
RAG_CONTEXT_TOKENS=4096
RAG_ANSWER_TOKENS=1024
MAX_UPLOAD_BYTES=20971520
# External browser port; the Gradio container listens internally on 7860.
FRONTEND_PORT=8501
BACKEND_TIMEOUT_SECONDS=600

# Native development only; Compose sets its own internal service addresses.
QDRANT_URL=http://localhost:6333
DOCUMENT_STORAGE_PATH=./data/documents
BACKEND_URL=http://localhost:8000
